# Playwright runtime
HEADLESS=true
SLOW_MO_MS=0

# Default search parameters (CLI flags override these)
DEFAULT_CITY=Charlotte
DEFAULT_NICHE=landscaping
DEFAULT_RESULTS_PER_NICHE=20
NO_WEBSITE_ONLY=false

# Rate limiting (milliseconds)
MIN_DELAY_MS=1500
MAX_DELAY_MS=4500
REQUESTS_PER_MINUTE=20

# Retries
MAX_RETRIES=3
RETRY_BASE_MS=2000

# NC Secretary of State filing date range filter (days back from today)
SOS_DAYS_BACK_MIN=30
SOS_DAYS_BACK_MAX=180

# Optional: skip a source entirely
ENABLE_SOS=true
ENABLE_GOOGLE_MAPS=true
ENABLE_FACEBOOK=true
ENABLE_YELP=false

# Output
OUTPUT_DIR=./output
